{
  "manifest_version": 3,
  "name": "StudyLens AI",
  "version": "1.0.0",
  "description": "AI-powered question solving and explanation assistant.",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": ["https://studylens-ai-9fia.onrender.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open StudyLens AI"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open StudyLens AI"
    }
  }
}
